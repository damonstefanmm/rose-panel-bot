# 复制为 .dev.vars 用于本地 `npm run preview` 调试（不会提交到 Git）
BOT_TOKEN="123456:REPLACE_WITH_YOUR_BOT_TOKEN"
BOT_USERNAME="your_bot"
APP_SHORT_NAME="panel"
# 推荐部署后在话题群内发 /bind 绑定，留空即可
SUPERGROUP_ID=""
# 必填：你自己 Telegram 个人账号的纯数字 UID（找 @userinfobot 获取，不是 @用户名，也不是机器人 ID），多个用英文逗号分隔
ADMIN_IDS=""
WEBHOOK_SECRET="change-me-to-a-random-secret"
PROBE_PROVIDER="komari"
PROBE_URL=""
PROBE_API_KEY=""
ENABLE_CHECKIN="false"
# 本地浏览器预览模式：仅在 localhost / 127.0.0.1 生效，生产环境请保持 "false"
# 本地调试时手动改为 "true" 即可在浏览器模拟预览
DEV_PREVIEW="false"
